    "saturation": 0.85,
    "gamma": 1.0,
    "lift": 0.03,
    "shadows": [
      -0.06,
      0.02,
      0.08
    ],
    "highlights": [
      0.03,
      0.01,
      -0.02
    ],
    "chroma_blur": 1,
    "grain": 10,
    "chroma_noise": 8,
    "vignette": 0.45,
    "scanlines": 0.08,
    "stamp": {
      "format": "minidv",
      "color": "#ffd23a",
      "size": 0.045
    }
  },
  "levels": {
