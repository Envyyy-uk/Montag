# Скопіюй у .env і заповни. Файл .env ніколи не потрапляє в git.

# --- Шляхи ---
LIBRARY_DIR=library
INBOX_DIR=inbox
DB_PATH=library/auto-editor.sqlite3

# --- Сервер ---
# Лише 127.0.0.1 або Tailscale-адреса (100.x.y.z). 0.0.0.0 заборонено.
HOST=127.0.0.1
PORT=8765
# Додаткова адреса Tailscale-інтерфейсу (Спринт 12), наприклад 100.101.102.103
TAILSCALE_HOST=
# PIN для входу з телефона (Спринт 12)
ACCESS_PIN=

# --- Gemini (Спринт 4) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MONTHLY_BUDGET_USD=10
CONFIRM_THRESHOLD_USD=1
DAILY_REQUEST_LIMIT=2000

# --- Черга ---
# Автостарт монтажу, якщо нові файли не надходять N хвилин
IDLE_MINUTES_BEFORE_EDIT=10

# --- Google Drive (Спринт 10) ---
GOOGLE_CLIENT_SECRET_FILE=
GOOGLE_TOKEN_FILE=
DRIVE_ROOT_FOLDER=Автомонтаж
# Запускати воркер усередині сервера (false — окремо: python -m worker)
RUN_WORKER_IN_SERVER=true
