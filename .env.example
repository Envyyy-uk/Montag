# Скопіюй у .env і заповни. Файл .env ніколи не потрапляє в git.

# --- Шляхи ---
LIBRARY_DIR=library
INBOX_DIR=inbox
DB_PATH=library/auto-editor.sqlite3

# --- Сервер ---
# Лише 127.0.0.1 або Tailscale-адреса (100.x.y.z). 0.0.0.0 заборонено.
HOST=127.0.0.1
PORT=8765
# Tailscale-адреса ноутбука (100.x.y.z); порожньо — визначається автоматично
TAILSCALE_HOST=
# HTTPS на Tailscale-адресі; сертифікат: python -m core tailscale-cert
HTTPS_PORT=8443
TLS_CERT_FILE=library/tls/cert.pem
TLS_KEY_FILE=library/tls/key.pem
# PIN для входу з телефона (щонайменше 4 цифри). Без нього віддалений доступ закритий
ACCESS_PIN=
# Мінімальна швидкість (Мбіт/с) для прямого завантаження на ноут; повільніше — через Google Drive
UPLOAD_DIRECT_MIN_MBPS=20

# --- Gemini (Спринт 4) ---
GEMINI_API_KEY=
# Модель Flash; ціни для підрахунку — у core/pricing.json (перевір на ai.google.dev/gemini-api/docs/pricing)
GEMINI_MODEL=gemini-flash-latest
# Рівень «роздумів» (low/medium/high); порожньо — як у моделі. Роздуми оплачуються як вихідні токени.
GEMINI_THINKING_LEVEL=low
# Довгі відео діляться на вікна по стільки секунд (один запит на вікно)
GEMINI_WINDOW_SECONDS=180
# Як часто перевіряти готовність batch-завдань, с
GEMINI_POLL_SECONDS=60
MONTHLY_BUDGET_USD=10
CONFIRM_THRESHOLD_USD=1
DAILY_REQUEST_LIMIT=2000

# --- Черга ---
# Автостарт монтажу, якщо нові файли не надходять N хвилин
IDLE_MINUTES_BEFORE_EDIT=10

# --- Google Drive (Спринт 10) ---
# OAuth-клієнт «Desktop app» з Google Cloud (Drive API увімкнено); вхід: python -m sources.gdrive auth
GOOGLE_CLIENT_SECRET_FILE=client_secret.json
GOOGLE_TOKEN_FILE=library/google_token.json
DRIVE_ROOT_FOLDER=Автомонтаж
# Як часто перевіряти Drive на нові відео, с
DRIVE_POLL_SECONDS=60
# Запускати воркер усередині сервера (false — окремо: python -m worker)
RUN_WORKER_IN_SERVER=true

# --- Стиль за замовчуванням: minidv-concert / summer-trip / vhs-90s / clean ---
DEFAULT_STYLE=minidv-concert

# --- Аналіз (Спринт 3) ---
# Пресет порогів фільтра браку, якщо в проєкту ще немає стилю: lofi або standard
DEFAULT_FILTER_PRESET=lofi
WHISPER_ENABLED=true
# tiny / base / small / medium / large-v3 (більша — точніша і повільніша)
WHISPER_MODEL=small
# uk, en … або порожньо для автовизначення
WHISPER_LANGUAGE=

# --- Рендер ---
# Висота готового кліпу (1080 — Full HD). 720p-превʼю робиться завжди.
RENDER_HEIGHT=1080

# --- Смак ---
# Інструкція смаку для Gemini і правила «назавжди» (програма дописує їх у кінець файлу)
TASTE_FILE=taste.md
